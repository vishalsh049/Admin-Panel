PORT=5001

DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
DB_SSL=false
DB_SYNC=false

JWT_SECRET=

# Comma-separated list of allowed frontend origins for CORS, in ADDITION to
# the production domains already hardcoded in server.js (divyadarshnam.com,
# www.divyadarshnam.com, admin.divyadarshnam.com, divyadarshnam.divyadarshnam.com)
# and localhost/127.0.0.1 (any port), which are always allowed.
# ALLOWED_ORIGINS is accepted as an alias for this same variable.
# Example: CLIENT_ORIGIN=https://pingslok.com,https://staging.example.com
CLIENT_ORIGIN=
# First entry of CLIENT_ORIGIN is used to build links (e.g. password-reset
# emails) unless CLIENT_URL is set explicitly. Set this to the primary
# public site URL, e.g. https://divyadarshnam.com
CLIENT_URL=

# SMTP credentials used for password-reset emails and contact-form
# notifications (admin/backend/utils/mailer.js). Email sending is skipped
# gracefully (logged, not fatal) until all three of HOST/USER/PASS are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Inbox that receives new contact-form inquiry notifications.
# Falls back to SMTP_FROM if unset.
CONTACT_NOTIFY_EMAIL=

# Google Sign-In OAuth Web Client ID (same value as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# FShip API integration settings
FSHIP_BASE_URL=https://capi-qc.fship.in/api
FSHIP_SIGNATURE=
FSHIP_PICKUP_ADDRESS_ID=
FSHIP_RETURN_ADDRESS_ID=
FSHIP_COURIER_ID=
