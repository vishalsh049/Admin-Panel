PORT=5001

DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
DB_SSL=false
DB_SYNC=false

JWT_SECRET=

# Comma-separated list of allowed frontend origins for CORS.
# Leave unset in development to allow all origins.
CLIENT_ORIGIN=
CLIENT_URL=

# SMTP credentials used for password-reset emails and contact-form
# notifications (admin/backend/utils/mailer.js). Email sending is skipped
# gracefully (logged, not fatal) until all three of HOST/USER/PASS are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Inbox that receives new contact-form inquiry notifications.
# Falls back to SMTP_FROM if unset.
CONTACT_NOTIFY_EMAIL=

# Google Sign-In OAuth Web Client ID (same value as frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
